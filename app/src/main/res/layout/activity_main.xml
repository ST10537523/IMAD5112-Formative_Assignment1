<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5DBE0"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="8dp"
        android:text="✨Social Sparks✨"
        android:textColor="#0A0A0A"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Stay connected, one spark at a time!"
        android:textColor="#0A0A0A"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etTimeOfDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:hint="Enter time of day (e.g. Morning)"
        android:inputType="text"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnGetSuggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#F6AFBD"
        android:text="Get My Spark 🔥"
        android:textColor="#0A0A0A" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="16dp"
        android:text=""
        android:textAlignment="center"
        android:textColor="#0A0A0A"
        android:textSize="20sp"
        android:textStyle="italic" />

    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#F6AFBD"
        android:text="Reset ↺"
        android:textColor="#0A0A0A" />

</LinearLayout>